# ---- LLM / embeddings (Google Gemini) ----
GOOGLE_API_KEY=AIza...

# ---- Web search (optional; Tavily preferred, DuckDuckGo keyless fallback) ----
TAVILY_API_KEY=tvly-...

# ---- LangSmith observability + evals ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=resume-demo-rag-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Models (override defaults if desired) ----
MODEL_FAST=gemini-3.6-flash
MODEL_HEAVY=gemini-3.6-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# ---- Storage / retrieval ----
CHROMA_DIR=./chroma_db
SQLITE_PATH=./memory.sqlite
RETRIEVER_K=4
